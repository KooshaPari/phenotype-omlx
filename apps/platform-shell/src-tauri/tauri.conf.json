{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phenotype Shell",
  "version": "0.1.0",
  "identifier": "org.phenotype.platform-shell",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:8090",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Phenotype — federated shell",
        "width": 1280,
        "height": 840,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
