# Primary observability (recommended): Langfuse — OSS / self-hostable, full control.
OBSERVABILITY_BACKEND=langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Self-host later: LANGFUSE_BASE_URL=http://127.0.0.1:3000  (Podman/Apple Container — never Docker)

# Optional legacy LangSmith
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=bench-cockpit
LANGSMITH_DATASET=bench-cockpit-v5-cells
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_TENANT_ID=

MINIMAX_API_KEY=
MINIMAX_JUDGE_MODEL=MiniMax-M3
PORTAGE_BIN="uv run harbor"
PORTAGE_ROOT=/Users/kooshapari/CodeProjects/Phenotype/repos/worktrees/portage/fix-langsmith-importerror
PORTAGE_VIEWER_URL=http://127.0.0.1:8123
PORTAGE_JOBS_DIR=
HARBOR_ENV=apple-container
