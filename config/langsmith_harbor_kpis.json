{
  "dataset": "omlx-harbor-tasks",
  "experiments": {
    "hello": "omlx-harbor-hello",
    "policy": "omlx-harbor-policy",
    "niah": "omlx-harbor-niah",
    "turbo": "omlx-harbor-turbo"
  },
  "feedback_keys": {
    "reward": {
      "source": "/logs/verifier/reward.txt",
      "meaning": "Primary Harbor trial score (0|1) posted as LangSmith feedback key `reward`"
    },
    "harbor_error": {
      "source": "trial.exception_info",
      "meaning": "Set when the trial raised; score=1 with exception type/message"
    }
  },
  "run_outputs": {
    "task_name": "Harbor task id",
    "trial_name": "Trial directory name",
    "rewards": "Verifier reward map (usually {\"reward\": 0|1})",
    "tokens.input": "Prompt tokens when agent reports usage",
    "tokens.output": "Completion tokens",
    "tokens.cost_usd": "Estimated cost when available"
  },
  "run_metadata": {
    "ls_runner": "harbor",
    "harbor_job_id": "Job UUID",
    "harbor_job_name": "Job name",
    "harbor_task_name": "Task name"
  },
  "cockpit_cell_kpis": [
    "pass_at_1",
    "gen_ok",
    "verified_pass_at_1",
    "partial_credit",
    "judge_score",
    "format_compliance_rate",
    "intent_preservation_rate",
    "hallucination_count",
    "wall_clock_s",
    "tokens_per_second"
  ]
}
