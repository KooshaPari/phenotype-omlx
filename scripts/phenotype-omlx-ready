#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COLLECTION_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
if [[ -z "${PYTHON_BIN:-}" && -x "${PHENOTYPE_OMLX_HOME:-${SCRIPT_DIR}/..}/.venv314/bin/python" ]]; then
    PYTHON_BIN="${PHENOTYPE_OMLX_HOME:-${SCRIPT_DIR}/..}/.venv314/bin/python"
fi
PYTHON_BIN="${PYTHON_BIN:-python3}"
"${PYTHON_BIN}" "${SCRIPT_DIR}/polyrepo_boundary.py" "$COLLECTION_ROOT" >/dev/null
exec "${PYTHON_BIN}" "${SCRIPT_DIR}/readiness_check.py" "$@"
